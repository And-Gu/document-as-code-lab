{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "label",
    "kind",
    "source_kind",
    "fictional",
    "representation",
    "original_binary_file_provided",
    "recorded_at",
    "owner_role",
    "source_status",
    "facts"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "source_kind": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "customer_schedule",
        "planning_extract",
        "resource_extract",
        "budget_extract",
        "meeting_note"
      ]
    },
    "recorded_at": {
      "type": "string",
      "minLength": 1
    },
    "owner_role": {
      "type": "string",
      "minLength": 1
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_external_ref": {
      "type": "string",
      "minLength": 1
    },
    "subject_external_label": {
      "type": "string",
      "minLength": 1
    },
    "source_status": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "approved_in_fictional_scenario",
        "forecast",
        "planning_estimate",
        "planning_forecast",
        "proposal"
      ]
    },
    "period_start": {
      "type": "string",
      "minLength": 1
    },
    "period_end": {
      "type": "string",
      "minLength": 1
    },
    "reporting_scope": {
      "type": "string",
      "minLength": 1
    },
    "valid_from": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "refinement_source"
    },
    "fictional": {
      "const": true
    },
    "representation": {
      "const": "curated_structured_excerpt"
    },
    "original_binary_file_provided": {
      "const": false
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "customer_commitment_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "forecast_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "required_hours": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "available_hours": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "baseline_minor": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "forecast_minor": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "minor_units_per_major": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "proposed_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "approval_evidence": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "oneOf": [
    {
      "required": [
        "subject_id"
      ],
      "not": {
        "required": [
          "subject_external_ref"
        ]
      }
    },
    {
      "required": [
        "subject_external_ref",
        "subject_external_label"
      ],
      "not": {
        "required": [
          "subject_id"
        ]
      }
    }
  ]
}
