{
  "name": "document-as-code-site",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "predev": "node scripts/preflight.mjs && node scripts/growth-report.mjs && node scripts/operational-snapshot.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/preflight.mjs && node scripts/build-information.mjs && node scripts/growth-report.mjs && node scripts/operational-snapshot.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test:learning": "node scripts/test-learning.mjs",
    "test:scenarios": "node scripts/test-scenarios.mjs",
    "test:content": "node scripts/test-content.mjs",
    "test:homepage": "node scripts/test-homepage.mjs",
    "test:curriculum": "node scripts/test-curriculum.mjs",
    "test:contracts": "node scripts/test-contracts.mjs",
    "test:dashboard": "node scripts/growth-report.mjs && node scripts/test-dashboard.mjs",
    "test:refinement": "node scripts/test-refinement.mjs",
    "test:e2e": "node scripts/run-browser-tests.mjs --project=chromium",
    "test:e2e:cross": "node scripts/run-browser-tests.mjs",
    "test:hosted": "node scripts/run-browser-tests.mjs --hosted",
    "test:verification": "node scripts/test-build-information.mjs",
    "build:fresh": "npm run prebuild && astro build --force",
    "test:scheduled-publish": "node scripts/test-verify-scheduled-publication.mjs",
    "test:incremental": "node scripts/test-incremental-build.mjs",
    "preflight": "node scripts/preflight.mjs",
    "precheck": "node scripts/preflight.mjs",
    "ci:impact": "node scripts/ci-impact.mjs",
    "test:tooling": "node --test scripts/test-delivery-tooling.mjs scripts/test-delivery-coordination.mjs",
    "delivery": "node scripts/delivery.mjs",
    "preflight:release": "node scripts/preflight.mjs release"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/react": "7.1.9",
    "@lucide/astro": "^1.52.0",
    "@revealjs/react": "0.2.2",
    "@rhpaiva/cssv": "0.5.0",
    "3d-force-graph": "1.80.2",
    "ajv": "8.20.0",
    "astro": "7.4.12",
    "chart.js": "^4.5.1",
    "markdown-it": "^15.0.3",
    "mermaid": "^12.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reveal.js": "^6.0.2",
    "three-spritetext": "1.10.0",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "1.64.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.22.2 <25",
    "npm": ">=11 <12"
  }
}
