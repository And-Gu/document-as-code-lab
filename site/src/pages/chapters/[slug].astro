---
import { render } from 'astro:content';
import Documentation from '../../layouts/Documentation.astro';
import { getChapters, chapterTitle } from '../../lib/chapters';
import { siteUrl } from '../../lib/urls';
import ChapterInformation from '../../components/ChapterInformation.astro';
import ProjectGrowth from '../../components/ProjectGrowth.astro';

export async function getStaticPaths() {
  const chapters = await getChapters();
  return chapters.map((chapter, index) => ({
    params: { slug: chapter.id },
    props: { chapter, previous: chapters[index - 1], next: chapters[index + 1] },
  }));
}
const { chapter, previous, next } = Astro.props;
const { Content, headings } = await render(chapter);
---

<Documentation title={chapterTitle(chapter)} activeChapter={chapter.id}>
  <p class="chapter-meta">Chapter {chapter.data.chapter_number} · {chapter.data.status}</p>
  <article>
    <h1 id={headings.find((heading) => heading.depth === 1)?.slug ?? chapter.id}>{chapterTitle(chapter)}</h1>
    <ChapterInformation chapter={chapter} />
    <Content />
    {chapter.id === '03-project-growth' && <ProjectGrowth />}
  </article>
  <div class="chapter-navigation" aria-label="Chapter navigation">
    {previous && <a href={siteUrl(`chapters/${previous.id}/`)}>Previous: {chapterTitle(previous)}</a>}
    {next && <a href={siteUrl(`chapters/${next.id}/`)}>Next: {chapterTitle(next)}</a>}
  </div>
</Documentation>
