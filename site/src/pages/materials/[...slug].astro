---
import { getCollection, render } from 'astro:content';
import Documentation from '../../layouts/Documentation.astro';
import { siteUrl } from '../../lib/urls';
import MaterialLearning from '../../components/learning/MaterialLearning.astro';
import BudgetTable from '../../components/BudgetTable.astro';
import RecordDetails from '../../components/materials/RecordDetails.astro';
import { materialRecord } from '../../lib/material-records';
import { repositoryRoot } from '../../lib/repository';
import { getChapters, chapterTitle } from '../../lib/chapters';

export async function getStaticPaths() {
  return (await getCollection('materials')).map((material) => ({
    params: { slug: material.id },
    props: { material },
  }));
}
const { material } = Astro.props;
const { Content, headings } = await render(material);
const record = await materialRecord(repositoryRoot, `${material.id}.md`);
const title = record?.title ?? headings.find((heading) => heading.depth === 1)?.text ?? material.id;
const relatedNumbers: Record<string, number[]> = {
  'reference/dashboards-and-work-tracking': [3],
  'reference/pdf-publication': [10, 11],
  'examples/learning/procedure-template': [5],
  'examples/onboarding-showcase/README': [1, 5, 7],
  'examples/contract-explorer/README': [9],
  'reference/review-and-collaboration': [2],
  'reference/growth-measurement': [3],
  'reference/record-processing': [5, 7],
  'reference/visual-sources': [6, 9],
  'reference/ai-context-and-agents': [8],
  'reference/project-knowledge': [8],
  'reference/automation-quality': [10, 11],
  'reference/publishing-workflows': [10],
  'reference/workflows-across-tools': [11],
  'presentations/README': [11],
  'site/README': [11],
};
const relatedChapters = (await getChapters()).filter(chapter => relatedNumbers[material.id]?.includes(chapter.data.chapter_number));
---

<Documentation title={title}>
  {!record && <p class="chapter-meta"><a href={siteUrl(`files/${material.id}.md`)}>Source file</a></p>}
  {relatedChapters.length > 0 && <p class="material-return">Return to the tutorial: {relatedChapters.map((chapter, index) => <>{index > 0 && ' · '}<a href={siteUrl(`chapters/${chapter.id}/`)}>Chapter {chapter.data.chapter_number}: {chapterTitle(chapter)}</a></>)}</p>}
  <article>{record && <RecordDetails record={record} />}<Content /><MaterialLearning source={material.id} />{material.id === 'reference/dashboards-and-work-tracking' && <BudgetTable />}</article>
</Documentation>
