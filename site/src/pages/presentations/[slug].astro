---
import { getPresentations, getPresentationDemo } from '../../lib/presentations';
import PresentationLayout from '../../layouts/PresentationLayout.astro';
import PresentationDeck from '../../components/slides/PresentationDeck';
import { siteUrl } from '../../lib/urls';
import { repositoryRoot } from '../../lib/repository';
import { buildCacheKey, fingerprintPaths } from '../../lib/incremental-build.mjs';

export async function getStaticPaths() {
  const demoKey = await fingerprintPaths(repositoryRoot, ['examples/onboarding-showcase']);
  return (await getPresentations()).map((presentation) => ({
    params: { slug: presentation.slug },
    cacheKey: buildCacheKey('presentation', presentation, demoKey),
    props: { presentation },
  }));
}
const { presentation } = Astro.props;
const records = presentation.slides.some((slide) => slide.type === 'content' && slide.demo)
  ? await getPresentationDemo() : [];
---
<PresentationLayout title={presentation.title} description={presentation.description}>
  <PresentationDeck presentation={presentation} records={records} client:load />
  <noscript><p class="presentation-fallback">Reading view. <a href={siteUrl(`presentations/${presentation.slug}/notes/`)}>Read the speaker notes</a>.</p></noscript>
</PresentationLayout>
