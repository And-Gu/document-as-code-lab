---
import { Network, ListFilter, GitBranch } from '@lucide/astro';
import { loadContractExplorer } from '../../lib/contract-loader';
import { changeImpact, deliveryCommitments, immediateEdges, relationLabels, statusScope } from '../../lib/contract-model';
import { repositoryRoot } from '../../lib/repository';
import { siteUrl } from '../../lib/urls';
import '../../styles/contract-explorer.css';
const data = await loadContractExplorer(repositoryRoot);
const initial = data.records.find(record => record.type === 'customer')!;
const initialEdges = immediateEdges(data, initial.id);
const label = (id: string) => data.records.find(record => record.id === id)!.label;
const sourceUrl = (source: string) => siteUrl(`files/${source}`);
const initialChange = data.records.find(record => record.type === 'amendment')!;
const initialImpact = changeImpact(data, initialChange.id);
const views = [{ id: 'relationships', title: 'Relationships', Icon: Network }, { id: 'commitments', title: 'Commitments', Icon: ListFilter }, { id: 'impact', title: 'Change impact', Icon: GitBranch }];
---
<section class="contract-explorer" data-contract-explorer aria-labelledby="ce-title">
  <header class="ce-header"><h3 id="ce-title">Contract Explorer</h3><p>Fictional example · Updated at build time</p>
    <small>Snapshot built <time datetime={data.builtAt}>{data.builtAt}</time> · {data.records.length} maintained records</small>
  </header>
  <script type="application/json" data-ce-data set:html={JSON.stringify(data).replaceAll('<', '\\u003c')} />
  <div class="ce-tabs" role="tablist" aria-label="Explorer view">
    {views.map(({id, title, Icon}) =>
      <button type="button" role="tab" id={`ce-tab-${id}`} aria-controls={`ce-panel-${id}`} aria-selected={id === 'relationships' ? 'true' : 'false'} tabindex={id === 'relationships' ? 0 : -1} data-ce-view={id} disabled><Icon size={17} />{title}</button>
    )}
  </div>
  <p data-ce-summary role="status" class="ce-summary">Recorded links for {initial.id} · {initial.label}</p>
  <section id="ce-panel-relationships" role="tabpanel" aria-labelledby="ce-tab-relationships" data-ce-panel="relationships">
    <label class="ce-control">Explore a record<select data-ce-record disabled>{data.records.map(record => <option value={record.id} selected={record.id === initial.id}>{record.id} · {record.label}</option>)}</select></label>
    <div class="ce-graph" data-ce-graph aria-label="Recorded relationships; the same links appear in the table below"></div>
    <div class="ce-table-wrap" tabindex="0" role="region" aria-label="Recorded relationship table"><table><caption>Recorded links · Table alternative to the graph</caption><thead><tr><th>From</th><th>Relationship</th><th>To</th></tr></thead>
      <tbody data-ce-links>{initialEdges.map(edge => <tr><td>{edge.source} · {label(edge.source)}</td><td>{relationLabels[edge.type]}</td><td>{edge.target} · {label(edge.target)}</td></tr>)}</tbody>
    </table></div>
  </section>
  <section id="ce-panel-commitments" role="tabpanel" aria-labelledby="ce-tab-commitments" data-ce-panel="commitments">
    <div class="ce-filters">
      <label class="ce-control">Project<select data-ce-project disabled><option value="">All projects</option>{data.records.filter(record => record.type === 'project').map(record => <option value={record.id}>{record.id} · {record.label}</option>)}</select></label>
      <label class="ce-control">Agreement<select data-ce-agreement disabled><option value="">All agreements</option>{data.records.filter(record => record.type === 'agreement').map(record => <option value={record.id}>{record.id} · {record.label}</option>)}</select></label>
    </div>
    <p>Agreement coverage is traced through each delivery's recorded project. Agreement lifecycle does not determine delivery execution status. Dates below are plans, not completion evidence.</p>
    <div class="ce-table-wrap" tabindex="0" role="region" aria-label="Delivery commitment table"><table><caption>Delivery commitments</caption><thead><tr><th>Delivery / Project</th><th>Planned date</th><th>Execution status</th><th>Agreements / Recorded terms</th></tr></thead>
      <tbody data-ce-deliveries>{deliveryCommitments(data).map(row => <tr>
        <td>{row.delivery.id} · {row.delivery.label}<br />{row.project.id}</td><td>{row.delivery.planned_date ?? 'Not recorded'}</td><td>{row.delivery.status}</td>
        <td>{row.agreements.map(agreement => <p>{agreement.id} · {agreement.status}<br />{agreement.body}</p>)}</td>
      </tr>)}</tbody>
    </table></div>
    <p data-ce-empty hidden>No deliveries match both filters.</p>
  </section>
  <section id="ce-panel-impact" role="tabpanel" aria-labelledby="ce-tab-impact" data-ce-panel="impact">
    <label class="ce-control">Assess a change<select data-ce-change disabled>{data.records.filter(record => ['agreement', 'amendment'].includes(record.type)).map(record => <option value={record.id} selected={record.type === 'amendment'}>{record.id} · {record.label}</option>)}</select></label>
    <p class="ce-notice" data-ce-impact-status>{initialChange.id} lifecycle status: {initialChange.status}. Following links identifies possible review work, not accepted updates.</p>
    <h4>Directly recorded links</h4><ul data-ce-direct>{initialImpact.direct.map(edge => <li>{edge.source} {relationLabels[edge.type]} {edge.target} (recorded)</li>)}</ul>
    <h4>Traversal-derived review candidates</h4><ul data-ce-candidates>{initialImpact.candidates.map(candidate => <li><strong>Review candidate: {candidate.id}</strong><ul>{candidate.path.map(edge => <li>{edge.source} {relationLabels[edge.type]} {edge.target} (recorded)</li>)}</ul></li>)}</ul>
  </section>
  <section class="ce-details" id="ce-details" aria-labelledby="ce-details-title">
    <h4 id="ce-details-title">Selected record</h4><div data-ce-details>
      <p><strong>{initial.id} · {initial.label}</strong></p><p>{initial.type} · {statusScope(initial)}: {initial.status}</p><p>{initial.body}</p>
      <p>Revision: {initial.revision}<br />SHA-256: <code>{initial.digest}</code></p>
      <a href={sourceUrl(initial.source)}>Read maintained Markdown: {initial.source}</a>
    </div>
  </section>
  <details data-ce-fallback open><summary>All maintained records and relationships</summary>
    {data.records.map(record => <article id={`ce-source-${record.id}`}>
      <h4>{record.id} · {record.label}</h4><p>{record.type} · {statusScope(record)}: <strong>{record.status}</strong></p>
      <p>{record.body}</p>{record.type === 'delivery' && <p>Planned date: {record.planned_date ?? 'Not recorded'}</p>}<p>Revision: {record.revision}</p><p class="ce-digest">SHA-256: {record.digest}</p>
      <ul>{record.relations.map(relation => <li>{relationLabels[relation.type]} <a href={`#ce-source-${relation.target}`}>{relation.target} · {label(relation.target)}</a></li>)}</ul>
      <p><a href={sourceUrl(record.source)}>Read maintained Markdown: {record.source}</a></p>
    </article>)}
  </details>
  <noscript><p>The records, source links, commitments, and relationship table remain readable here. Enable JavaScript to select records and switch views.</p></noscript>
</section>
<script>
  import { initContractExplorers } from '../../lib/contract-controller';
  initContractExplorers(); document.addEventListener('astro:page-load', initContractExplorers);
</script>
