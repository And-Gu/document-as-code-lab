  <a href={linkedInUrl} rel="me" aria-label="Anders Gustafsson on LinkedIn" title="LinkedIn">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.35V9h3.414v1.561h.049c.476-.9 1.637-1.85 3.37-1.85 3.6 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zM6.777 20.452H3.893V9h2.884v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z" />
    </svg>
  </a>
</div>
<style>
  .header-social-links { margin-left: auto; display: flex; align-items: center; gap: .125rem; flex: 0 0 auto; }
  .header-social-links a { display: inline-flex; justify-content: center; align-items: center; width: 2.5rem; height: 2.5rem; border-radius: .5rem; color: inherit; text-decoration: none; font-weight: normal; }
  .header-social-links a:hover { background: color-mix(in srgb, currentColor 9%, transparent); }
  .header-social-links a:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
  .header-social-links svg { width: 1.25rem; height: 1.25rem; display: block; }
</style>
