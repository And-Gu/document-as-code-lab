      <path d="M12 .297a12 12 0 0 0-3.793 23.384c.6.111.82-.261.82-.577 0-.285-.011-1.04-.017-2.041-3.338.726-4.043-1.609-4.043-1.609-.546-1.386-1.333-1.755-1.333-1.755-1.09-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.493.997.108-.775.418-1.304.762-1.604-2.665-.304-5.467-1.333-5.467-5.931 0-1.311.469-2.382 1.236-3.222-.124-.303-.536-1.524.118-3.176 0 0 1.009-.323 3.301 1.23A11.526 11.526 0 0 1 12 5.804c1.02.005 2.047.138 3.007.404 2.291-1.553 3.299-1.23 3.299-1.23.655 1.652.243 2.873.12 3.176.77.84 1.235 1.911 1.235 3.222 0 4.61-2.807 5.624-5.479 5.922.43.372.823 1.102.823 2.222 0 1.606-.015 2.899-.015 3.293 0 .319.216.694.825.576C20.565 21.796 24 17.301 24 12c0-6.627-5.373-12-12-12z" />
